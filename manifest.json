{
  "manifest_version": 3,
  "name": "Prompt Assistant",
  "description": "Save reusable chat pretext and enhance prompts once with AI.",
  "version": "1.6",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://gapgpt.app/*"
  ],
  "background": {
    "scripts": ["src/background/service-worker.js"],
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://gapgpt.app/*"
      ],
      "js": [
        "src/content/constants.js",
        "src/content/platforms/chatgpt.js",
        "src/content/platforms/perplexity.js",
        "src/content/platforms/deepseek.js",
        "src/content/platforms/gapgpt.js",
        "src/content/platforms/index.js",
        "src/content/state.js",
        "src/content/observer.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{2a2e4ab0-546b-4009-a586-5336abfbb8f6}",
      "strict_min_version": "109.0"
    }
  }
}
